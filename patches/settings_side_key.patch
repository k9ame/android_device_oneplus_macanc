+package com.android.settings.sidekey;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Availability controller for the side-key settings entry. */
+public class SideKeyPreferenceController extends BasePreferenceController {
+
+    public SideKeyPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
