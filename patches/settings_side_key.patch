+package com.android.settings.sidekey;
+
+import android.app.settings.SettingsEnums;
+import android.os.Bundle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+
+/**
+ * Settings page for the OnePlus Plus Key (side key).
+ *
+ * <p>Stores the selected actions in Settings.System; the framework's
+ * SideKeyController reads the same keys and performs the action.
+ */
+public class SideKeySettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    // Keep in sync with frameworks/base SideKeyController.
+    private static final String KEY_ENABLED = "side_key_enabled";
+    private static final String KEY_SINGLE = "side_key_single_action";
+    private static final String KEY_DOUBLE = "side_key_double_action";
+    private static final String KEY_LONG = "side_key_long_action";
+
+    private static final int ACTION_NONE = 0;
+    private static final int ACTION_CYCLE_RINGER = 1;
+    private static final int ACTION_SCREENSHOT = 5;
+
+    private SwitchPreferenceCompat mEnabled;
+    private ListPreference mSingle;
+    private ListPreference mDouble;
+    private ListPreference mLong;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.side_key_settings);
+
+        mEnabled = findPreference(KEY_ENABLED);
+        mSingle = findPreference(KEY_SINGLE);
+        mDouble = findPreference(KEY_DOUBLE);
+        mLong = findPreference(KEY_LONG);
+
+        mEnabled.setChecked(Settings.System.getInt(getContentResolver(), KEY_ENABLED, 1) != 0);
+        mEnabled.setOnPreferenceChangeListener(this);
+
+        mSingle.setValue(String.valueOf(getAction(KEY_SINGLE, ACTION_CYCLE_RINGER)));
+        mDouble.setValue(String.valueOf(getAction(KEY_DOUBLE, ACTION_NONE)));
+        mLong.setValue(String.valueOf(getAction(KEY_LONG, ACTION_SCREENSHOT)));
+
+        mSingle.setOnPreferenceChangeListener(this);
+        mDouble.setOnPreferenceChangeListener(this);
+        mLong.setOnPreferenceChangeListener(this);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String key = preference.getKey();
+        if (KEY_ENABLED.equals(key)) {
+            Settings.System.putInt(getContentResolver(), KEY_ENABLED,
+                    (Boolean) newValue ? 1 : 0);
+            return true;
+        }
+
+        try {
+            Settings.System.putInt(getContentResolver(), key,
+                    Integer.parseInt((String) newValue));
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    private int getAction(String key, int defaultValue) {
+        return Settings.System.getInt(getContentResolver(), key, defaultValue);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+}
